### Check is email available
POST {{serverUrl}}/email-available
Content-Type: application/json

{
  "email": "henry@test.com"
}

### REGISTER
POST {{serverUrl}}/register
Content-Type: application/json

{
  "email": "henry@test.com",
  "password": "henry@password",
  "firstName": "Henry",
  "lastName": "Kobyla",
  "dateOfBirth": "1493-01-01",
  "homeAddress": "Street of the Smith, Skalitz, Bohemia"
}

### LOGIN & Set accessToken
POST {{serverUrl}}/auth/login
Content-Type: application/json

{
  "email": "henry@test.com",
  "password": "henry@password"
}

> {% client.global.set("accessToken", response.body.accessToken); %}

### TEST - Get user profile
GET {{serverUrl}}/user/profile
Authorization: Bearer {{accessToken}}

### REFRESH
POST {{serverUrl}}/auth/refresh
Content-Type: application/json

> {% client.global.set("accessToken", response.body.accessToken) %}

### LOGOUT
POST {{serverUrl}}/auth/logout
#Authorization: Bearer {{accessToken}}
